# Optional. Copy to .env to pre-fill the lab's Connect page; everything can also be
# entered in the app. Never commit .env.

# Your DataHub (GMS API + UI). Token auth must be enabled
# (METADATA_SERVICE_AUTH_ENABLED=true); create a token under Settings > Access Tokens.
# From inside Docker, a DataHub on your machine is host.docker.internal, not localhost.
DATAHUB_GMS_URL=http://host.docker.internal:8080
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_GMS_TOKEN=
# Limit the DataHub scope (comma-separated). The demo data lives on the postgres platform.
DATAHUB_PLATFORMS=postgres

# Your Airflow 3.x. The default reaches the demo Airflow (docker compose --profile demo).
# LAB_AIRFLOW_URL=http://host.docker.internal:8088
# AIRFLOW_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string

# AI model (bring your own key). Providers: openai, anthropic, gemini, groq, openrouter, ollama
# LLM_PROVIDER_ID=openrouter
# LLM_API_KEY=
# LLM_MODEL_ID=openai/gpt-oss-120b
